# Copy to .env and fill in. Real environment variables override this file.
PORT=3000
SITE_URL=https://www.your-domain.ca
SITE_NAME=Rumors
# Behind a reverse proxy / load balancer (Nginx, Render, Fly, Cloudflare)? set to true
TRUST_PROXY=false
# Long random string; if omitted one is generated in data/secret.key
APP_SECRET=
# First admin is created on startup if no admin exists yet (min 12 chars). Remove after first run.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Optional IndexNow key (Bing, Yandex, Seznam, Naver instant indexing)
INDEXNOW_KEY=
# Daily Web radar scan (runs after 6 a.m. Toronto time). Set to true to turn it off, e.g. on a second server.
RADAR_DISABLED=false

# AI drafts: OPENAI_API_KEY (used first if set) or ANTHROPIC_API_KEY lets "Create draft" (Web radar) and "Approve" (Rumor tips) write full articles.
# Get one at https://platform.claude.com/settings/keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
